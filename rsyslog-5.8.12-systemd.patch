diff -Naur rsyslog-8.2606.0/rsyslog.service.in rsyslog-8.2606.0/rsyslog.service.in
--- rsyslog-8.2606.0/rsyslog.service.in	1970-01-01 00:00:00.000000000 +0000
+++ rsyslog-8.2606.0/rsyslog.service.in	2026-08-03 00:00:00.000000000 +0000
@@ -0,0 +1,20 @@
+[Unit]
+Description=System Logging Service
+Requires=syslog.socket
+Documentation=man:rsyslogd(8)
+Documentation=https://www.rsyslog.com/doc/
+
+[Service]
+Type=notify
+EnvironmentFile=-/etc/sysconfig/rsyslog
+ExecStart=@sbindir@/rsyslogd -n $SYSLOGD_OPTIONS
+StandardOutput=null
+Restart=on-failure
+
+# Increase the default a bit in order to allow many simultaneous
+# files to be monitored, we might need a lot of fds.
+LimitNOFILE=16384
+
+[Install]
+WantedBy=multi-user.target
+Alias=syslog.service
